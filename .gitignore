# Dependencies
node_modules

# Playwright output (regenerated every run — never tracked)
test-results/
playwright-report/
tests/screenshots/
src/web-games/screenshots/
src/web-games/tests/screenshots/
# v0.11.0 T-05: per-game screenshot dirs (tests/<game>/screenshots) — runs
# overwrite them; goldens/evidence with a real consumer live outside tests/
src/web-games/tests/*/screenshots/

# Runtime artifacts
.server.pid
.server-*.pid
tests/.server-*.pid

# Environment secrets (never commit)
.env
*.env.local

# prints de referência do operador (material de estudo, não asset do jogo)
img/

# Godot editor caches
.godot/
