; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Aero Fighters — Inhaúma"
config/description="F-35 ground-strike e defesa antiaérea sobre Inhaúma / Cachoeira da Prata. Port do web-game (Three.js) para Godot 4.7 Forward+."
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://autoload/GameConfig.gd"
GameState="*res://autoload/GameState.gd"
AudioManager="*res://autoload/AudioManager.gd"
MCPGameBridge="res://addons/godot_mcp/game_bridge/mcp_game_bridge.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("godot_mcp")

[godot_mcp]

bind_mode=0
custom_bind_ip=""
port_override_enabled=false
port_override=6550

